# PostgreSQL 接続文字列（pg_trgm 拡張を使用）
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zenbunavi?schema=public"

# 公開URL（sitemap・OGP・クローラーの User-Agent に使用）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# /api/cron/crawl の認証キー。未設定の場合、エンドポイントは常に 401 を返す
CRON_SECRET=""

# 運営方針ページに表示する問い合わせ先
CONTACT_EMAIL="contact@example.com"
