# PostgreSQL 接続文字列（pg_trgm 拡張を使用）
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/zenbunavi?schema=public"

# 公開URL（sitemap・OGP・クローラーの User-Agent に使用）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# /api/cron/crawl の認証キー。未設定の場合、エンドポイントは常に 401 を返す
CRON_SECRET=""

# 運営方針ページに表示する問い合わせ先
CONTACT_EMAIL="contact@example.com"

# AI まとめ記事（任意）。未設定の場合、まとめ記事は作成されない
ANTHROPIC_API_KEY=""
# 使用するモデル（既定: claude-opus-5-5。費用を抑える場合は claude-sonnet-5-5）
# AI_MODEL="claude-opus-5-5"
# 対象にするトピックの最小報道媒体数（既定: 3）と、1回の収集で作成する最大本数（既定: 5）
# AI_MIN_PUBLISHERS=3
# AI_MAX_PER_RUN=5
